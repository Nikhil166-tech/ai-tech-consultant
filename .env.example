# ==============================================================================
# AI Tech Consultant - Production Environment Configuration
# ==============================================================================

# --- Environment & Security ---
# 'development' allows demo auth and default development secrets.
# 'production' strictly enforces non-default secrets, HTTPS cookies, and disables demo logins.
ENVIRONMENT=development

# Shared secret for internal service-to-service communication (Task 2 & 3 -> Task 1)
INTERNAL_SERVICE_KEY=your_internal_service_shared_secret_here

# Secret key used for cryptographic session signing and verification
SESSION_SECRET=your_production_session_signing_secret_here

# Comma-separated allowed origins for credentialed CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Authentication & lockout controls
DEMO_AUTH_ENABLED=true
SESSION_EXPIRY_DAYS=7
FAILED_LOGIN_LIMIT=5
LOCKOUT_DURATION_MINUTES=15

# ==============================================================================
# Task 1 Knowledge Brain Configuration
# ==============================================================================

# --- Anthropic LLM & Vision Settings ---
# Anthropic API Key (Required for live Claude inference and vision analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Active Claude models (Configurable for evaluation benchmark selection)
ANTHROPIC_MODEL_TEXT=claude-haiku-5-5
ANTHROPIC_MODEL_VISION=claude-sonnet-5-5
ANTHROPIC_WORKSPACE_ID=your_anthropic_workspace_id_here

# --- Google Gemini LLM Settings ---
# Gemini API Key (Required for live Gemini inference)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_TEXT=gemini-3.5-flash
GEMINI_MODEL_VISION=gemini-3.5-flash
MODEL_KB_ANSWER=gemini-3.5-flash
MODEL_CLASSIFICATION=gemini-3.5-flash
MODEL_DRAFTING=gemini-3.5-flash
MODEL_REQUIREMENTS_EXTRACTION=gemini-3.5-flash
MODEL_CAPABILITY_CHECKING=gemini-3.5-flash
ALLOW_PREVIEW_MODELS=false
MAX_FALLBACK_ATTEMPTS=3
TOTAL_TIMEOUT_SECONDS=15.0
REQUEST_TIMEOUT_SECONDS=5.0

# --- Learned Semantic Embedding Settings ---
# Provider: 'fastembed' (learned ONNX embeddings) or 'deterministic_test' (unit tests only)
EMBEDDING_PROVIDER=fastembed

# HuggingFace model identifier for FastEmbed dense semantic embeddings
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# --- Storage Settings ---
# SQLite database path for persistent knowledge memory, chunks, and expert queues
KNOWLEDGE_DB_PATH=knowledge_brain.db

# Target documentation sitemap URL
DEFAULT_SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml

# --- Polite Crawler Settings ---
# Polite crawl delay between consecutive page fetches (seconds)
CRAWLER_DELAY_SECONDS=0.3

# Maximum concurrent article requests during sitemap synchronization
MAX_CONCURRENT_REQUESTS=3

# Transient retry parameters with exponential backoff (for 5xx and network dropouts)
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=0.5

# --- Lightweight Daily Synchronization ---
# Enable background 24-hour recurring sitemap sync (false for tests and local dev)
ENABLE_BACKGROUND_SYNC=false

# Daily sync interval in hours (default: 24.0)
SYNC_INTERVAL_HOURS=24.0

# --- Retrieval & RAG Heuristics ---
# Hybrid search balance (alpha * lexical + (1-alpha) * dense_semantic)
HYBRID_ALPHA=0.55

# Evidence threshold for triggering automated specialist escalation (0.0 to 1.0)
EVIDENCE_THRESHOLD=0.30
